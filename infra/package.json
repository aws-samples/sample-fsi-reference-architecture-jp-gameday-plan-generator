{
  "name": "gameday-plan-generator-infra",
  "version": "0.1.0",
  "description": "CDK infrastructure for GameDay Plan Generator",
  "type": "module",
  "bin": {
    "gameday-infra": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all --require-approval never",
    "destroy": "cdk destroy --all --force",
    "diff": "cdk diff"
  },
  "overrides": {
    "esbuild": "$esbuild"
  },
  "devDependencies": {
    "@aws-sdk/client-ssm": "^3.1092.0",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^20.14.0",
    "aws-cdk": "^2.1132.0",
    "aws-cdk-lib": "^2.265.0",
    "cdk-nag": "^3.0.1",
    "constructs": "^10.3.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "cognito-at-edge": "^1.5.4"
  }
}
